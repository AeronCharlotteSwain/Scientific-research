# Raw and processed data: large, often licensed, and rebuildable from code.
# Document every source in data/README.md instead.
data/raw/*
!data/raw/.gitkeep
data/clean/*
!data/clean/.gitkeep

# Stata logs (regenerated by every run)
output/logs/*
!output/logs/.gitkeep
*.smcl

# Literature PDFs (copyrighted; keep them in Zotero)
literature/*.pdf

# OS / Office temp files
.DS_Store
Thumbs.db
desktop.ini
~$*
*.tmp
